# Production settings for docker-compose.prod.yml.
# On the VM: copy to infra/docker/.env, fill in, then `chmod 600 infra/docker/.env`.
# Never commit the filled-in file (.env is gitignored).
#
# Generate each secret fresh on the VM; never reuse a development value:
#   openssl rand -hex 32

# --- Public address ---------------------------------------------------------
# The VM's DNS name. Caddy gets the HTTPS certificate for it; Shopify calls it.
DOMAIN=ecomrecommender.swedencentral.cloudapp.azure.com
# Contact address for the certificate authority (Let's Encrypt) account.
ACME_EMAIL=

# --- Core service -----------------------------------------------------------
# Database password. Hex only, because it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=
# Lets the Shopify connector create stores (POST /v1/stores). Shared by core and connector.
CORE_ADMIN_KEY=
# Folder on the VM holding current.joblib and fallback.joblib.
MODELS_DIR=/home/azureuser/recsys-models

# --- Shopify connector (the prod app, "Recommender") ------------------------
# Partner dashboard -> Recommender -> Settings. The client ID is public; the secret is not.
SHOPIFY_API_KEY=9b6336a812f6f2a6e5e3c053aa2c1a7a
SHOPIFY_API_SECRET=
# Must match `scopes` in connectors/shopify/shpfy-rec-app/shopify.app.production.toml.
SCOPES=write_products,write_metaobjects,write_metaobject_definitions,write_app_proxy,write_pixels,read_customer_events
