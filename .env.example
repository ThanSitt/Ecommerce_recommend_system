# Copy to .env and fill in. .env is gitignored — never commit real values.

# Core service
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Store API keys are not configured here: each store gets its own from POST /v1/stores,
# and the core keeps only their hashes in the stores table.

# Lets a connector create stores (POST /v1/stores). Shared by the core and the connector
# app only, never sent to a browser. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CORE_ADMIN_KEY=admin-key-change-me

# PostgreSQL
DATABASE_URL=postgresql+psycopg://recsys:recsys@localhost:5432/recsys

# Redis
REDIS_URL=redis://localhost:6379/0

# Model serving — the service loads the current artefact by path, it does not
# pick versions itself (see CLAUDE.md).
MODEL_PATH=models/current.joblib

# Deployment gate: a new model must beat the live one by this relative margin
# on the held-out set before it replaces it.
GATE_METRIC=ndcg@10
GATE_MIN_RELATIVE_IMPROVEMENT=0.0

# Connectors (not used by core)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
CORE_API_URL=http://localhost:8000
# Only the Python Shopify connector (pixel events) uses this, until /pixel moves into the
# Shopify app. Copy your dev shop's coreApiKey from the app's Shop table (prisma studio).
CORE_API_KEY=
