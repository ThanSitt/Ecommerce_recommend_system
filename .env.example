# Copy to .env and fill in. .env is gitignored — never commit real values.

# Core service
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# API keys issued to stores (comma-separated during development)
CORE_API_KEYS=dev-key-change-me

# PostgreSQL
DATABASE_URL=postgresql+psycopg://recsys:recsys@localhost:5432/recsys

# Redis
REDIS_URL=redis://localhost:6379/0

# Model serving — the service loads the current artefact by path, it does not
# pick versions itself (see CLAUDE.md).
MODEL_PATH=models/current.joblib

# Deployment gate: a new model must beat the live one by this relative margin
# on the held-out set before it replaces it.
GATE_METRIC=ndcg@10
GATE_MIN_RELATIVE_IMPROVEMENT=0.0

# Connectors (not used by core)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
CORE_API_URL=http://localhost:8000
CORE_API_KEY=dev-key-change-me
